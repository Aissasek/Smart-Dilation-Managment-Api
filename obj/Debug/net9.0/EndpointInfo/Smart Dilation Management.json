  "components": {
    "schemas": {
      "AddNewDoctor": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddNewPatient": {
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "DilationDTO": {
        "type": "object",
        "properties": {
          "eyeDropId": {
            "type": "integer",
            "format": "int32"
          },
          "staffId": {
            "type": "integer",
            "format": "int32"
          },
          "dropsRequired": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "password": {
            "maxLength": 20,
            "minLength": 4,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateDoctor": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdatePatient": {
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "dropsGiven": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "dropsRequired": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "dropTypeId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "lastDropTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
